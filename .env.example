# Signs admin session cookies — generate with: openssl rand -base64 32
SESSION_SECRET=
# Admin account created by `npm run db:setup` (or updated by `npm run admin:reset`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Production only — added automatically by the Vercel Turso and Blob integrations.
# Leave unset locally to use the data/app.db file and data/uploads folder.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
